<?xml version="1.0"?>
<launch>

    <arg name="use_sim_time" default="true"/>

    <node
        pkg="nav2_controller"
        exec="controller_server"
        name="controller_server"
        output="screen">

        <param from="$(find-pkg-share cortex_navigation)/config/controller_server.yaml"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

    <node
        pkg="nav2_planner"  
        exec="planner_server"
        name="planner_server"
        output="screen">

        <param from="$(find-pkg-share cortex_navigation)/config/planner_server.yaml"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

    <node
        pkg="nav2_smoother"
        exec="smoother_server"
        name="smoother_server"
        output="screen">

        <param from="$(find-pkg-share cortex_navigation)/config/smoother_server.yaml"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

    <node
        pkg="nav2_bt_navigator"
        exec="bt_navigator"
        name="bt_navigator"
        output="screen">

        <param from="$(find-pkg-share cortex_navigation)/config/bt_navigator.yaml"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>
    
    <node
        pkg="nav2_lifecycle_manager"
        exec="lifecycle_manager"
        name="lifecycle_manager_navigation"
        output="screen">

        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param name="autostart" value="true"/>

        <param
            name="node_names"
            value="['controller_server',
                    'planner_server',
                    'smoother_server',
                    'bt_navigator']"/>
    </node>

</launch>