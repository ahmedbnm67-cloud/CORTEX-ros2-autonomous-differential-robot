<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
<!-- ============================================ -->
<!-- Gazebo contact parameters – realistic values -->
<!-- ============================================ -->
    <gazebo reference="wheel_left_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>10000000.0</kp>   <!-- Reduced from 1e12 to 1e7 -->
        <kd>100.0</kd>        <!-- Increased damping for stability -->
        <minDepth>0.001</minDepth> <!-- Increased slightly to allow soft contact -->
        <maxVel>1.0</maxVel>      <!-- Allow faster correction to prevent sinking -->
        <fdir1>1 0 0</fdir1>
    </gazebo>
    
    <gazebo reference="wheel_right_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>10000000.0</kp>
        <kd>100.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>1.0</maxVel>
        <fdir1>1 0 0</fdir1>
    </gazebo>   
    <gazebo reference="caster_front_link">
        <mu1>0.5</mu1>
        <mu2>0.5</mu2>
        <kp>5000000.0</kp>    <!-- Moderate stiffness -->
        <kd>50.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>1.0</maxVel>
    </gazebo>
    
    <gazebo reference="caster_rear_link">
        <mu1>0.5</mu1>
        <mu2>0.5</mu2>
        <kp>5000000.0</kp>
        <kd>50.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>1.0</maxVel>
    </gazebo>   
    
    <gazebo>
        <plugin filename="gz_ros2_control-system"
        name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>/home/ubuntu/cortex_ws/src/cortex_controller/config/controller.yaml</parameters>
        </plugin>
    </gazebo>
    <gazebo>
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>  
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>
    </gazebo>

</robot>
