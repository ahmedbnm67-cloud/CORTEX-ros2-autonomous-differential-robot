<?xml version="1.0" encoding="utf-8"?>
<robot name="cortex" xmlns:xacro="http://www.ros.org/wiki/xacro">
  
  <xacro:include filename="common_properties.xacro"/>
  <xacro:include filename="cortex_gazebo.xacro"/>
  <xacro:include filename="ros2_control.xacro"/>
  <xacro:include filename="imu_sensor.xacro"/>
  <xacro:include filename="lidar_sensor.xacro"/>
  <link name="base_footprint"/>


  <link name="base_link">
    <inertial>
      <origin xyz="0.0 0.0 0.10506" rpy="0 0 0"/>
      <mass value="4.3369"/>
      <inertia
        ixx="0.035501"
        ixy="-2.9739E-06"
        ixz="-2.1376E-06"
        iyy="0.048962"
        iyz="1.7265E-18"
        izz="0.065221"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://cortex_description/meshes/base_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="${blue}"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://cortex_description/meshes/base_link.STL"/>
      </geometry>
    </collision>
  </link>


  <joint name="basefoot_to_baselink_joint" type="fixed">
    <origin xyz="0.0 0.0 0.0595" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <axis xyz="0 0 0"/>
  </joint>


  <link name="wheel_left_link">
    <inertial>
      <origin xyz="0.0 -0.006 0.0" rpy="0 0 0"/>
      <mass value="0.060355"/>
      <inertia
        ixx="1.9285E-05"
        ixy="-2.1415E-21"
        ixz="4.3685E-21"
        iyy="3.4547E-05"
