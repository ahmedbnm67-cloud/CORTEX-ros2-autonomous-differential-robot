      <geometry>
        <mesh filename="package://cortex_description/meshes/wheel_left_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="${dark_grey}"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.034"/>
      </geometry>
    </collision>
  </link>


  <joint name="base_leftwheel_joint" type="continuous">
    <origin xyz="-2.9396E-05 0.1505 -0.026487" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_right_link">
