  <link name="imu_link">
    <inertial>
      <origin xyz="-0.00053544 0.00032312 0.0021553" rpy="0 0 0"/>
      <mass value="0.0037346"/>
      <inertia
        ixx="1.8127E-07"
        ixy="1.9895E-10"
