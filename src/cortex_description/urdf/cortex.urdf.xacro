      <mass value="0.0005236"/>
      <inertia
        ixx="5.236E-09"
        ixy="-3.5257E-42"
        ixz="4.4842E-41"
        iyy="5.236E-09"
        iyz="0"
        izz="5.236E-09"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
